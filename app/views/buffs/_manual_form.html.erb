<% if buff.errors.any? %>
  <p class="text-red-600 text-xs py-1"><%= buff.errors.full_messages.to_sentence %></p>
<% end %>

<%= form_with url: character_buffs_path(character), scope: :buff,
      class: "flex flex-wrap items-center gap-1 text-sm border-b border-gray-100 py-1" do |form| %>

  <div class="flex items-center gap-1 flex-1 min-w-32">
    <span class="text-xs text-gray-500 shrink-0">名前</span>
    <%= form.text_field :name,
          value: buff.name,
          placeholder: "例: 陽光の魔符",
          class: "flex-1 min-w-16 border rounded px-2 py-1 text-sm" %>
  </div>

  <div class="flex items-center gap-1">
    <span class="text-xs text-gray-500 shrink-0">対象</span>
    <%= form.select :target_status,
          options_for_select(target_status_options, buff.target_status),
          { include_blank: "未選択" },
          class: "border rounded px-1 py-1 text-sm w-24" %>
  </div>

  <div class="flex items-center gap-1">
    <span class="text-xs text-gray-500 shrink-0">補正値</span>
    <%= form.number_field :bonus_value,
          min: -999, max: 999, value: buff.bonus_value,
          class: "border rounded px-1 py-1 text-sm w-16" %>
  </div>

  <div class="flex items-center gap-1">
    <span class="text-xs text-gray-500 shrink-0">持続R</span>
    <%= form.number_field :duration_rounds,
          min: 0, max: 50, value: buff.duration_rounds,
          placeholder: "空欄で無期限",
          class: "border rounded px-1 py-1 text-sm w-16" %>
  </div>

  <%= form.submit "登録", class: "bg-blue-600 hover:bg-blue-700 text-white text-xs px-2 py-1 rounded cursor-pointer" %>
  <%= link_to "キャンセル", character_path(character),
        class: "text-gray-500 hover:text-gray-700 text-xs px-1" %>
<% end %>
