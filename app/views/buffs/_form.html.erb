<% if preset_error.present? %>
  <p class="text-red-600 text-xs py-1"><%= preset_error %></p>
<% end %>

<%= form_with url: character_buffs_path(character), scope: :buff, class: "flex items-center gap-2 mt-3" do |f| %>
  <%= f.select :buff_preset_id,
        options_from_collection_for_select(buff_presets, :id, :name),
        { include_blank: "プリセットを選択" },
        class: "border rounded px-2 py-1 text-sm" %>
  <%= f.submit "登録", class: "bg-blue-600 hover:bg-blue-700 text-white text-sm px-3 py-1 rounded cursor-pointer" %>
<% end %>
