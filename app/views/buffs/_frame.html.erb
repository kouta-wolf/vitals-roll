<%= turbo_frame_tag dom_id(character, :buffs) do %>
  <%= render "buffs/list", character: character, selected_weapon: local_assigns[:selected_weapon] %>

  <%= render "buffs/form", character: character, buff_presets: buff_presets, preset_error: local_assigns[:preset_error] %>

  <% if buff %>
    <%= render "buffs/manual_form", character: character, buff: buff %>
  <% else %>
    <%= link_to "＋ バフを手動登録", new_character_buff_path(character),
          class: "text-blue-600 hover:underline text-sm mt-2 inline-block" %>
  <% end %>
<% end %>
