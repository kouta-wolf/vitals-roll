<main class="bg-gray-50">
  <div class="m-4 p-8 bg-blue-200 max-w-lg mx-auto flex flex-col justify-center items-center gap-4 rounded-2xl">
    <h1 class="text-3xl font-bold">新しいパスワードの設定</h1>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "w-full space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, "新しいパスワード", class: "block mb-1 font-medium text-slate-700" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-slate-500 mb-1"><%= @minimum_password_length %>文字以上で入力してください</p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "w-full rounded-md border border-slate-300 bg-white px-4 py-2.5 transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/40 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "block mb-1 font-medium text-slate-700" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full rounded-md border border-slate-300 bg-white px-4 py-2.5 transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/40 focus:outline-none" %>
      </div>

      <%= f.submit "パスワードを変更",
            class: "w-full inline-flex h-12 items-center justify-center rounded-md bg-blue-600 hover:bg-blue-700 px-6 font-medium text-white transition active:scale-95 hover:cursor-pointer" %>
    <% end %>
  </div>
</main>
