<tr class="text-center hover:bg-gray-50">
  <td class="px-4 py-3 font-medium text-blue-700"><%= link_to character.name, character_path(character) %></td>
  <td class="px-4 py-3 text-gray-600"><%= character.race %></td>
  <td class="px-4 py-3 text-gray-600"><%= character.main_class %></td>
  <td class="px-4 py-3 text-gray-600"><%= character.main_class_level %></td>
  <td class="px-4 py-3 text-gray-500 text-sm"><%= character.updated_at.strftime("%Y/%m/%d %H:%M") %></td>
  <td class="px-4 py-3">
    <div class="flex justify-center gap-3">
      <%= link_to "編集", edit_character_path(character) %>
      <%= button_to "削除", character_path(character), method: :delete, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
    </div>
  </td>
</tr>
