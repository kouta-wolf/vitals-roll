<% if selected_weapon.nil? %>
  <p class="text-gray-500 mt-2">武器が登録されていません。判定式を表示するには武器を登録してください。</p>
<% else %>
  <div data-controller="weapon-formula" class="mt-2">
    <label class="block text-sm font-medium mb-1">武器選択</label>
    <select data-weapon-formula-target="select" data-action="change->weapon-formula#change"
            class="border border-gray-300 rounded px-2 py-1">
      <% weapons.each do |weapon| %>
        <option value="<%= weapon.id %>" <%= "selected" if weapon == selected_weapon %>><%= weapon.name %></option>
      <% end %>
    </select>

    <%= form_with url: hit_formula_character_path(character), method: :get, class: "hidden",
          data: { weapon_formula_target: "hitForm", turbo_stream: true } do |f| %>
      <%= f.hidden_field :weapon_id, value: selected_weapon.id, data: { weapon_formula_target: "hitWeaponId" } %>
    <% end %>

    <%= form_with url: attack_formula_character_path(character), method: :get, class: "hidden",
          data: { weapon_formula_target: "attackForm", turbo_stream: true } do |f| %>
      <%= f.hidden_field :weapon_id, value: selected_weapon.id, data: { weapon_formula_target: "attackWeaponId" } %>
    <% end %>

    <p class="mt-2">命中判定式: <span id="<%= dom_id(character, :hit_formula) %>"><%= character.hit_formula(selected_weapon) %></span></p>
    <p class="mt-2">ダメージ判定式: <span id="<%= dom_id(character, :attack_formula) %>"><%= character.attack_formula(selected_weapon) %></span></p>
  </div>
<% end %>
