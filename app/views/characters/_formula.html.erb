<%= turbo_frame_tag dom_id(character, :formula) do %>
  <% if selected_weapon.nil? %>
    <p class="text-gray-500 mt-2">武器が登録されていません。判定式を表示するには武器を登録してください。</p>
  <% else %>
    <div class="mt-2">
      <label class="block text-sm font-medium mb-1">武器選択</label>
      <div class="flex gap-2">
        <% weapons.each do |weapon| %>
          <%= link_to weapon.name, character_path(character, weapon_id: weapon.id),
                class: "px-3 py-1 rounded border text-sm #{weapon == selected_weapon ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-700 border-gray-300'}" %>
        <% end %>
      </div>

      <p class="mt-2 flex items-center gap-2" data-controller="clipboard">
        命中判定式:
        <span data-clipboard-target="source"><%= character.hit_formula(selected_weapon) %></span>
        <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
            class="px-2 py-0.5 text-xs rounded border border-gray-300 bg-white hover:bg-gray-50">
          コピー
        </button>
      </p>
      <p class="mt-2 flex items-center gap-2" data-controller="clipboard">
        ダメージ判定式:
        <span data-clipboard-target="source"><%= character.attack_formula(selected_weapon) %></span>
        <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
            class="px-2 py-0.5 text-xs rounded border border-gray-300 bg-white hover:bg-gray-50">
          コピー
        </button>
      </p>
    </div>
  <% end %>
<% end %>
