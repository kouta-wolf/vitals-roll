<%# Turboのキャッシュから復元されると data-combat-state が古いDB状態のまま復活し、
    次の操作で保存済みの値を上書きしてしまうため、このページはキャッシュさせない %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<main>
  <section class="flex justify-between items-center border-b border-gray-300 p-4">
    <div>
      <h1 class="text-3xl"><%= @character.name %></h1>
      <p class="text-gray-500"><%= @character.race %>/<%= @character.main_class %>/Lv:<%= @character.main_class_level %></p>
    </div>
    <%= link_to "キャラクター編集", edit_character_path(@character),
        class: "inline-flex h-10 items-center rounded-md bg-blue-600 hover:bg-blue-700 px-4 text-white transition active:scale-95 hover:cursor-pointer" %>
  </section>

  <%# Reactのマウント先。描画自体は下の各パネルへPortalで差し込むため、ここには何も表示しない。
      初期データはdata属性で渡す（Railsが属性値をエスケープするのでhtml_safeが不要） %>
  <div data-react-root hidden data-combat-state="<%= combat_state_data(@character, @weapons).to_json %>"></div>

  <div class="flex gap-4 flex-1 m-4">
    <div class="flex flex-col gap-4 flex-1">
      <section class="p-4 border border-gray-300">
        <h2 class="text-2xl">ラウンド管理</h2>

        <div id="round-panel"></div>
      </section>

      <section class="p-4 border border-gray-300">
        <h2 class="text-2xl">有効な効果、補正一覧</h2>

        <div id="buff-list-panel"></div>

        <%# バフの登録はRails側のまま（#160のスコープ外） %>
        <%= render "buffs/form", character: @character, buff_presets: @buff_presets, preset_error: nil %>

        <%= link_to "＋ バフを手動登録", new_character_buff_path(@character),
              class: "text-blue-600 hover:underline text-sm mt-2 inline-block" %>
      </section>

      <section class="p-4 border border-gray-300">
        <h2 class="text-2xl">キャラクター基礎情報</h2>

        <ul class="mt-2 space-y-1">
          <li>器用度（DEX）: <%= @character.dexterity %></li>
          <li>敏捷度（AGI）: <%= @character.agility %></li>
          <li>筋力（STR）: <%= @character.strength %></li>
          <li>生命力（VIT）: <%= @character.vitality %></li>
          <li>知力（INT）: <%= @character.intelligence %></li>
          <li>精神力（MND）: <%= @character.spirit %></li>
          <li>防護点: <%= @character.defense %></li>
        </ul>
      </section>
    </div>

    <div class="flex-1">
      <section class="p-4 border border-gray-300">
        <h2 class="text-2xl">判定式</h2>

        <div id="formula-panel"></div>
      </section>
    </div>
  </div>
</main>
