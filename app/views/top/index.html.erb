<main class="bg-linear-to-br from-blue-100 via-sky-100 to-indigo-100">
  <section class="py-32 flex flex-col items-center gap-16">
    <h1 class="my-4 text-slate-800 text-6xl font-bold text-center">
      Vitals Rollを使って<br>TRPGセッションを<span class="text-blue-600">高速化</span>しよう
    </h1>
    <p class="text-center text-gray-400">
      現在はSW2.5のみ対応しています。<br>順次更新予定
    </p>
    <%= link_to "今すぐ始める", new_user_registration_path, class: "inline-flex h-12 items-center justify-center rounded-md bg-blue-600 hover:bg-blue-700 px-24 text-white transition active:scale-95 hover:cursor-pointer" %>
  </section>
  <section class="py-16  flex flex-col items-center gap-8">
    <h2 class="text-4xl text-center">
      画面紹介
    </h2>
    <%= image_tag "develop_img.png", alt: "開発中のイメージ画像", class: "m-4 max-w-4xl mx-auto shadow-lg" %>
    <p class="text-gray-500 ">※現在開発中の画面です</p>
  </section>
</main>
